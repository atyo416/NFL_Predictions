{
  "version": "moneyline-paper-m8-v1",
  "scope": "NFL h2h; research and simulated wagers only",
  "stake_units": 1.0,
  "thresholds": [
    0.0,
    0.03,
    0.05
  ],
  "default_threshold": 0.03,
  "default_model": "official_logistic",
  "bookmaker_priority": [
    "draftkings",
    "fanduel",
    "betmgm"
  ],
  "selection_rule": "First eligible bookmaker by fixed priority then lexical key; highest model-EV side, home on ties; strictly above threshold",
  "max_quote_age_minutes": 15,
  "max_forecast_age_hours": 24,
  "kickoff_tolerance_seconds": 300,
  "minimum_fetch_interval_seconds": 300,
  "max_http_attempts": 2,
  "max_retry_delay_seconds": 1,
  "cohorts": {
    "24h": {
      "lead_hours": 24,
      "tolerance_minutes": 15
    },
    "6h": {
      "lead_hours": 6,
      "tolerance_minutes": 10
    },
    "1h": {
      "lead_hours": 1,
      "tolerance_minutes": 5
    }
  },
  "historical_seasons": [
    2024,
    2025
  ],
  "closing_window_minutes": 10,
  "sensitivity_probability_shifts": [
    -0.05,
    -0.02,
    0.0,
    0.02,
    0.05
  ],
  "bootstrap_replicates": 2000,
  "confidence_level": 0.95,
  "seed": 42,
  "selection": "No threshold or model selection from evaluated returns; all sensitivity policies reported separately",
  "promotion": "No model changes or real-money transactions",
  "frozen_m7_policy": "E1_equal__raw"
}
